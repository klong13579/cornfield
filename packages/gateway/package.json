{
  "name": "@cornfield/gateway",
  "version": "1.0.0",
  "description": "IM gateway for CornField — connects AI agents to messaging platforms",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "start": "bun run ./src/cli.ts start",
    "build": "bun scripts/build-binary.ts",
    "check": "biome check . && tsgo -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "fmt": "biome format --write .",
    "fix": "biome check --write --unsafe .",
    "test": "bun test"
  },
  "dependencies": {
    "@cornfield/coding-agent": "workspace:*",
    "@cornfield/utils": "catalog:",
    "@sinclair/typebox": "catalog:",
    "croner": "10.0.1",
    "dingtalk-stream": "2.1.6-beta.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@dingtalk-real-ai/dingtalk-connector": "0.8.23",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.7"
  }
}
