{
	"type": "module",
	"name": "@cornfield/self-evolution",
	"version": "1.0.0",
	"description": "Self-evolution plugin for CornField: automatic skill extraction and episodic memory",
	"homepage": "https://github.com/klong13579/cornfield",
	"author": "Can Boluk",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/klong13579/cornfield.git",
		"directory": "packages/self-evolution"
	},
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"scripts": {
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "biome lint .",
		"test": "echo [paused] self-evolution tests disabled while feature is off",
		"fix": "biome check --write --unsafe .",
		"fmt": "biome format --write ."
	},
	"dependencies": {
		"@cornfield/cognitive-coordination": "workspace:*",
		"@cornfield/ai": "catalog:",
		"@cornfield/coding-agent": "catalog:",
		"@cornfield/utils": "catalog:"
	},
	"devDependencies": {
		"@sinclair/typebox": "catalog:",
		"@types/bun": "catalog:"
	},
	"engines": {
		"bun": ">=1.3.7"
	},
	"files": [
		"src",
		"README.md",
		"CHANGELOG.md"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./memory": {
			"types": "./src/memory/index.ts",
			"import": "./src/memory/index.ts"
		},
		"./evolution-memory": {
			"types": "./src/evolution-memory.ts",
			"import": "./src/evolution-memory.ts"
		},
		"./memory/*": {
			"types": "./src/memory/*.ts",
			"import": "./src/memory/*.ts"
		},
		"./*": {
			"types": "./src/*.ts",
			"import": "./src/*.ts"
		}
	}
}
