{
  "name": "@oh-my-pi/pi-gateway",
  "version": "14.5.13",
  "description": "IM gateway for Oh My Pi — connects AI agents to messaging platforms",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "start": "bun run ../coding-agent/src/cli.ts gateway start",
    "check": "biome check . && tsgo -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "fmt": "biome format --write .",
    "fix": "biome check --write --unsafe .",
    "test": "bun test"
  },
  "dependencies": {
    "@oh-my-pi/pi-coding-agent": "workspace:*",
    "@oh-my-pi/pi-utils": "catalog:",
    "@sinclair/typebox": "catalog:",
    "croner": "10.0.1",
    "dingtalk-stream": "2.1.6-beta.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@dingtalk-real-ai/dingtalk-connector": "0.8.23",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.7"
  }
}
