{
	"name": "@oh-my-pi/desktop",
	"version": "0.0.0",
	"private": true,
	"description": "OMP 桌面壳（Electron）—— 托盘常驻 + 探测/拉起 omp serve sidecar",
	"type": "module",
	"main": "dist/main.js",
	"scripts": {
		"dev": "bun run build && electron .",
		"build": "esbuild src/main.ts src/sidecar.ts --outdir=dist --platform=node --target=node22 --format=esm && esbuild src/preload.ts --outdir=dist --platform=node --target=node22 --format=cjs --out-extension:.js=.cjs",
		"dist": "bun run build && electron-builder",
		"build:desktop": "bun scripts/build.ts",
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "biome lint .",
		"fmt": "biome format --write .",
		"fix": "biome check --write --unsafe ."
	},
	"dependencies": {
		"electron-updater": "^6.8.9"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@types/node": "^24.9.0",
		"@typescript/native-preview": "catalog:",
		"electron": "43.4.1",
		"electron-builder": "^26.15.3",
		"esbuild": "^0.25.12",
		"typescript": "catalog:"
	},
	"engines": {
		"bun": ">=1.3.7"
	}
}