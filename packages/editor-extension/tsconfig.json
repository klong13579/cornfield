{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": [
			"ES2024",
			"DOM",
			"DOM.Iterable",
			"DOM.AsyncIterable",
			"WebWorker"
		],
		"jsx": "react-jsx",
		"types": [
			"node",
			"bun"
		],
		"noImplicitAny": false,
		"strictFunctionTypes": false,
		"strictPropertyInitialization": false
	},
	"include": [
		"src",
		"scripts"
	],
	"exclude": [
		"dist",
		"dist-node",
		"hosted",
		"workspace",
		"extensions",
		"node_modules"
	]
}
