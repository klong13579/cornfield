{
	"name": "@oh-my-pi/editor-extension",
	"version": "0.0.0",
	"private": true,
	"description": "omp client shell integration layer (OpenSumi 3.9.1-next + web-app theme + omp ACP agent registration)",
	"type": "commonjs",
	"scripts": {
		"check": "biome check . --no-errors-on-unmatched",
		"build": "cross-env NODE_ENV=production NODE_OPTIONS=--max_old_space_size=5120 npm-run-all -p compile:browser compile:node compile:worker-host compile:ext-host compile:webview",
		"compile:browser": "webpack --config ./configs/webpack.browser.config.js",
		"compile:node": "webpack --config ./configs/webpack.node.config.js",
		"compile:worker-host": "cross-env NODE_ENV=production webpack --config ./configs/webpack.worker-host.config.js",
		"compile:ext-host": "cross-env NODE_ENV=production webpack --config ./configs/webpack.ext-host.config.js",
		"compile:webview": "cross-env NODE_ENV=production webpack --config ./configs/webpack.webview.config.js",
		"start": "npm-run-all -p start:client start:server start:webview",
		"start:client": "cross-env NODE_ENV=development webpack-dev-server --config ./configs/webpack.browser.config.js --progress --color",
		"start:server": "cross-env EXT_MODE=js KTLOG_SHOW_DEBUG=1 ts-node -r tsconfig-paths/register ./src/node/index.ts",
		"start:webview": "webpack-dev-server --config ./configs/webpack.webview.config.js",
		"smoke": "bun run scripts/smoke.ts"
	},
	"dependencies": {
		"@opensumi/di": "1.10.1",
		"@opensumi/ide-addons": "3.9.1-next-1787303337.0",
		"@opensumi/ide-ai-native": "3.9.1-next-1787303337.0",
