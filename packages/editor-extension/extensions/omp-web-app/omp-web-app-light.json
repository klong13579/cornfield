		"editor.inactiveSelectionBackground": "#f4f4f5",
		"editor.lineHighlightBackground": "#f4f4f5",
		"editorCursor.foreground": "#18181b",
		"editorGutter.background": "#fafafa",
		"editorLineNumber.foreground": "#a1a1aa",
		"editorLineNumber.activeForeground": "#52525b",
		"editorWidget.background": "#ffffff",
		"editorWidget.border": "#e4e4e7",
		"editorSuggestWidget.background": "#ffffff",
		"editorSuggestWidget.border": "#e4e4e7",
		"editorIndentGuide.background": "#e4e4e7",
		"editorIndentGuide.activeBackground": "#d4d4d8",
		"editorGroup.border": "#e4e4e7",
		"editorGroupHeader.tabsBackground": "#f4f4f5",
		"editorGroupHeader.tabsBorder": "#e4e4e7",
		"editorError.foreground": "#d64545",
		"editorWarning.foreground": "#b97c1e",
		"editorInfo.foreground": "#0288a8",
		"editorHint.foreground": "#a1a1aa",
		"tab.activeBackground": "#ffffff",
