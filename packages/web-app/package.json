{
	"type": "module",
	"name": "@cornfield/web-app",
	"version": "0.0.0",
	"private": true,
	"description": "CornField 多端前端 Web 应用（React + Vite + Tailwind，V6 亮色 token）",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "biome lint .",
		"test": "bun test --path-ignore-patterns=test/e2e",
		"fix": "biome check --write --unsafe .",
		"fmt": "biome format --write .",
		"e2e:smoke": "bun run build && playwright test",
		"test:ci": "E2E=1 bun run e2e:smoke"
	},
	"dependencies": {
		"@fontsource-variable/geist": "5.3.0",
		"@fontsource-variable/geist-mono": "5.3.0",
		"@cornfield/client": "catalog:",
		"@cornfield/wire": "catalog:",
		"croner": "10.0.1",
		"lucide-react": "catalog:",
		"mermaid": "11.16.1",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-markdown": "10.1.0",
		"react-router-dom": "^7.1.1",
		"rehype-highlight": "7.0.2",
		"rehype-katex": "7.0.1",
		"rehype-raw": "^7.0.0",
		"rehype-sanitize": "^6.0.0",
		"remark-gfm": "4.0.1",
		"remark-math": "6.0.0",
		"thinking-orbs": "0.3.1"
	},
	"devDependencies": {
		"@playwright/test": "1.60.0",
		"@tailwindcss/vite": "^4.2.4",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@typescript/native-preview": "catalog:",
		"@vitejs/plugin-react": "^4.3.4",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "^6.3.5"
	},
	"engines": {
		"bun": ">=1.3.7"
	}
}
