{
	"type": "module",
	"name": "@oh-my-pi/web-app",
	"version": "0.0.0",
	"private": true,
	"description": "OMP 多端前端 Web 应用（React + Vite + Tailwind，V6 亮色 token）",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "biome lint .",
		"test": "bun test",
		"fix": "biome check --write --unsafe .",
		"fmt": "biome format --write ."
	},
	"dependencies": {
		"@oh-my-pi/pi-client": "catalog:",
		"@oh-my-pi/pi-wire": "catalog:",
		"croner": "10.0.1",
		"lucide-react": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-router-dom": "^7.1.1",
		"thinking-orbs": "0.3.1"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.2.4",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@typescript/native-preview": "catalog:",
		"@vitejs/plugin-react": "^4.3.4",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "^6.3.5"
	},
	"engines": {
		"bun": ">=1.3.7"
	}
}
