{
	"type": "module",
	"name": "@oh-my-pi/moa-extension",
	"version": "14.5.12",
	"description": "Mixture-of-Agents extension for omp",
	"homepage": "https://github.com/can1357/oh-my-pi",
	"author": "Narwal",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/can1357/oh-my-pi.git",
		"directory": "packages/moa-extension"
	},
	"bugs": {
		"url": "https://github.com/can1357/oh-my-pi/issues"
	},
	"keywords": [
		"moa",
		"mixture-of-agents",
		"planning",
		"agent",
		"extension"
	],
	"main": "./src/extension.ts",
	"types": "./src/extension.ts",
	"scripts": {
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "biome lint .",
		"fix": "biome check --write --unsafe .",
		"fmt": "biome format --write .",
		"test": "bun test"
	},
	"dependencies": {
		"@oh-my-pi/pi-utils": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "catalog:"
	},
	"peerDependencies": {
		"@oh-my-pi/pi-coding-agent": "^14"
	},
	"engines": {
		"bun": ">=1.3.7"
	},
	"omp": {
		"extensions": [
			"./src/extension.ts"
		]
	},
	"files": [
		"src",
		"CHANGELOG.md",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./src/extension.ts",
			"import": "./src/extension.ts"
		}
	}
}
